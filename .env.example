DATABASE_PATH=./data/aniflow.sqlite
NEXT_PUBLIC_APP_NAME=Aniflow
TZ=Asia/Shanghai

# Optional web UI / API access control.
# When AUTH_PASSWORD is set, all pages and APIs require login (or Bearer/Basic auth).
# Leave empty only for loopback access. Non-local hosts are denied without it.
AUTH_PASSWORD=
# Optional HMAC secret for session cookies. Defaults to a value derived from AUTH_PASSWORD.
AUTH_SECRET=
# Optional: force Secure flag on session cookies ("true" or "false"). Auto-detected from HTTPS headers when unset.
COOKIE_SECURE=
# Optional: comma-separated extra HTTPS Mikan mirror hostnames (mikanani.me and mikanime.tv are built-in).
MIKAN_ALLOWED_HOSTS=
