DATABASE_PATH=./data/aniflow.sqlite
NEXT_PUBLIC_APP_NAME=Aniflow
TZ=Asia/Shanghai

# Optional web UI / API access control.
# When AUTH_PASSWORD is set, all pages and APIs require login (or Bearer/Basic auth).
# Leave empty for open local access.
AUTH_PASSWORD=
# Optional HMAC secret for session cookies. Defaults to a value derived from AUTH_PASSWORD.
AUTH_SECRET=
